<link rel="stylesheet" href="app.css" />

@{
    ViewBag.Title = "Forgot Password Page";
    Layout = "_EmptyLayout";
}

<div class="forgot-container">
    <div class="forgot-image-box">
        <img src="~/images/forgot_password.png" alt="Forgot Password" class="forgot-image" />
    </div>

    <form method="post" asp-controller="Account" asp-action="ForgotPassword" class="forgot-form">
        <div class="password-text">
            <p>Forgot</p>
            <label for="email">Your Password ?</label>
            <input type="email" id="email" name="email" placeholder="Enter Email Address">
        </div>

        
        @if (TempData["InvalidMessage"] != null)
        {
            <div class="invalid-email-message">@TempData["InvalidMessage"]</div>
        }
        else if (TempData["Message"] != null)
        {
            <div class="valid-email-message">@TempData["Message"]</div>
        }

        <button type="submit" class="send-link-btn">Send Reset Link</button>
        <a asp-controller="Account" asp-action="Login" class="link-signin">Back to Sign In</a>
    </form>


</div>