<link rel="stylesheet" href="app.css" />
@model ResetPasswordVM

@{
    ViewBag.Title = "Reset Password Page";
    Layout = "_EmptyLayout";
}
<div class="auth-background forgot-reset-background">
    <div class="reset-password-wrapper">

        <p class="reset-password-title">Change Password</p>

        <div class="reset-container">
            <div class="reset-image-box">
                <img src="~/images/reset_password.png" alt="Reset Password" class="reset-image" />
            </div>

            <form method="post" asp-controller="Account" asp-action="ResetPassword" class="reset-form">
                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="Email" />

                <div class="password-text">
                    <label for="new-password">New Password</label>
                    <input type="password" id="new-password" asp-for="NewPassword" placeholder="New Password" required>
                    <span asp-validation-for="NewPassword" class="text-error"></span>

                    <label for="confirm-password">Confirm Password</label>
                    <input type="password" id="confirm-password" asp-for="ConfirmPassword" placeholder="Confirm Password" required>
                    <span asp-validation-for="ConfirmPassword" class="text-error"></span>
                </div>

                <button type="submit" class="reset-btn">Reset Password</button>
            </form>
        </div>

    </div>
</div>