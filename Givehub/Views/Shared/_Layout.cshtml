@using System.Security.Claims

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width" , initial-scale="1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Sharp" />
    @RenderSection("head", false)
    @* <script src="~/js/app.js"></script> *@

</head>
<body>
    <header>    
        <a asp-controller="Home" asp-action="Index" class="header-link">
            <img src="~/images/logo.png" alt="logo" style="width: 100px; height: 40px;">
        </a>
        <a asp-controller="Home" asp-action="Index" class="header-link">About Us</a>
        <a asp-controller="Home" asp-action="Donation" class="header-link">Donation</a>
        <a asp-controller="Home" asp-action="Contact" class="header-link">Contact</a>
        
        @{
            var donorIdClaim = User.FindFirstValue(ClaimTypes.NameIdentifier);
            var roleClaim = User.FindFirstValue(ClaimTypes.Role);
        }

        @if (string.IsNullOrEmpty(donorIdClaim))
        {
            <a asp-controller="Account" asp-action="Login" class="login-btn">Login</a>
        }
        else
        {
            <div class="profile-dropdown">
                <img src="~/images/user_icon.png" alt="User Icon" class="user-icon" />
                
                <div class="dropdown-menu">
                    <a asp-controller="Donor" asp-action="ViewMoney">View Money</a>
                    <a asp-controller="Report" asp-action="ItemReport">Item Report</a>
                    <a asp-controller="Account" asp-action="Logout">Logout</a>
                </div>
            </div>
        }

    </header>
    <main>
        @RenderBody()
    </main>
    <footer>
        <a asp-controller="Home" asp-action="Index" class="footer-link">About us</a>
        <a asp-controller="Home" asp-action="Donation" class="footer-link">Donation</a>
        <a href="#" class="footer-link">How to fundraise</a>
        <a asp-controller="Home" asp-action="Contact" class="footer-link">Contact</a>
    </footer>

    <script src="/js/jquery.min.js"></script>
    <script src="js/jquery.unobtrusive-ajax.min.js"></script>
    <script src="js/jquery.validate.min.js"></script>
    <script src="js/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
