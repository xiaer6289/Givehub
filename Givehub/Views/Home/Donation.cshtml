@model IEnumerable<Givehub.Models.Donee>
@{
    ViewBag.Title = "Donation";
}
<div class="page-search">
    

    <form method="get" asp-action="Donation" class="search" id="searchForm">

        <input class="search-input-box"
               id="searchBox"
               name="search"
               placeholder="Search by name or location"
               value="@ViewBag.Search" />

        <select name="category" class="search-category" id="categorySelect">
            <option value="" selected="@(string.IsNullOrEmpty(ViewBag.Category))">
                All Categories
            </option>
            <option value="Orphanages" selected="@(ViewBag.Category == "Orphanages")">
                Orphanages
            </option>
            <option value="Nursing Homes" selected="@(ViewBag.Category == "Nursing Homes")">
                Nursing Homes
            </option>
            <option value="Refugees" selected="@(ViewBag.Category == "Refugees")">
                Refugees
            </option>
        </select>

        <button type="submit" class="search-btn">
            <span class="material-symbols-sharp">search</span>
        </button>

        <button type="button" class="search-clear-btn" onclick="clearSearch()">
            Clear
        </button>

    </form>
</div>

<div class="needs-table">

    @if (!Model.Any())
    {
        <p>No result found for "@ViewBag.Search"</p>
    }
    else
    {
        @foreach (var d in Model)
        {
            <a asp-controller="Donee"
               asp-action="ViewDonee"
               asp-route-id="@d.Id"
               asp-route-mode="user"
               class="needs-wrapper">

                @if (!string.IsNullOrEmpty(d.Image))
                {
                    <img src="@Url.Content(d.Image)" alt="@d.Name" />
                }
                else
                {
                    <img src="~/images/no-image.png" alt="No image" />
                }

                <p>@d.Name</p>
                <p>@d.Category</p>
                <p>@d.Requirements</p>
            </a>
        }
    }

</div>

<p class="pagination-count">
    Page <span>@ViewBag.CurrentPage</span> of <span>@ViewBag.TotalPages</span>
</p>

<div class="pagination">

    <a asp-action="Donation"
       asp-controller="Home"
       asp-route-page="@(ViewBag.CurrentPage > 1 ? ViewBag.CurrentPage - 1 : 1)"
       asp-route-search="@ViewBag.Search"
       asp-route-category="@ViewBag.Category"
       class="@(ViewBag.CurrentPage == 1 ? "disabled" : "")">
        Prev
    </a>

    @for (int i = 1; i <= ViewBag.TotalPages; i++)
    {
        if (i == ViewBag.CurrentPage)
        {
            <span class="current-page">@i</span>
        }
        else
        {
            <a asp-action="Donation"
               asp-controller="Home"
               asp-route-page="@i"
               asp-route-search="@ViewBag.Search"
               asp-route-category="@ViewBag.Category">
                @i
            </a>
        }
    }

    <a asp-action="Donation"
       asp-controller="Home"
       asp-route-page="@(ViewBag.CurrentPage<ViewBag.TotalPages? ViewBag.CurrentPage + 1 : ViewBag.TotalPages)"
       asp-route-search="@ViewBag.Search"
       asp-route-category="@ViewBag.Category"
       class="@(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
        Next
    </a>

</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        let searchTimeout;

        document.getElementById('searchBox').addEventListener('input', function () {
            clearTimeout(searchTimeout);

            searchTimeout = setTimeout(() => {
                document.getElementById('searchForm').submit();
            }, 500);
        });

        document.getElementById('categorySelect').addEventListener('change', function () {
            document.getElementById('searchBox').value = ''; 
            document.getElementById('searchForm').submit();
        });

    });

    function clearSearch() {
        document.getElementById('searchBox').value = '';
        window.location.href = '@Url.Action("Donation", "Home")';
    }
</script>
