<div class="contact-container">
    <div class="contact-wrapper">
        <div class="contact-header">
            <h1 class="contact-heading">Get In Touch</h1>
            <p class="contact-desc">Reach out to us for any support or donation-related assistance</p>
        </div>
        <div class="general-line">
            <h4>General Line: </h4>
            <p>+603-0000 0000</p>
        </div>
        <div class="email-line">
            <h4>Email: </h4>
            <p>johndoe@example.com</p>
        </div>
    </div>
    <form method="post" class="contact-form" asp-controller="home" asp-action="SendContactForm">
        <input type="text" placeholder="Name" name="Name" required>
        <input type="text" placeholder="Phone Number" name="PhoneNo" required>
        <input type="email" placeholder="Email" name="Email" required>
        <div class="checkbox-grp">
            <p class="contact-needs">Needs: </p>
            <label>
                <input type="checkbox" name="Needs" value="Monetary Donation">Monetary Donation
            </label>
            <label>
                <input type="checkbox" name="Needs" value="Medical Supplies">Medical Supplies
            </label>
            <label>
                <input type="checkbox" name="Needs" value="Clothing and Shelter">Clothing and Shelter
            </label>
            <label>
                <input type="checkbox" name="Needs" value="Basic Neccessities">Basic Necessities
            </label>
        </div>
        <button type="submit" class="submit-btn">Submit</button>
    </form>
</div>
