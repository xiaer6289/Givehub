@using Givehub.Models

@{ 
    ViewBag.Title = "Index";
}

<p>Admin ID: @(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "None")</p>
<p>Donor ID: @(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "None")</p>
<p>Role: @(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "None")</p>
<p>Password Reset Done: @(User.FindFirst("PasswordResetDone")?.Value ?? "false")</p>

<div class="hero-section">
    <div class="hero-overlay">
        <img src="~/images/img2.png" alt="Community helping each other" class="hero-bg-img" style="width: 100%;">
        <div class="hero-content">
            <h1>Let us build a better community</h1>
            <p class="hero-subtitle">Bridging the gap between abundance and need in Malaysia</p>
            <a href="#intro" class="custom-btn">Read Our Mission</a>
        </div>
    </div>
</div>

<div class="container-custom">
    <section id="intro" class="section-intro">
        <h2>Introduction</h2>
        <p class="intro-desc">
            In Malaysia, the number of children and families requiring monetary support and essential items has increased.
            With over <strong>64,000 children</strong> in care institutions and <strong>182,000 refugees</strong>,
            many struggle to meet basic daily needs. We aim to change that.
        </p>
    </section>

    <section class="beneficiaries-grid">
        <div class="card">
            <div class="card-img-wrapper">
                <img src="~/images/img11.png" alt="Children" class="card-img">
            </div>
            <div class="card-body">
                <h3>Orphanages</h3>
                <p>
                    Many children come from broken homes due to poverty rather than the loss of parents.
                    Institutions face shortages of food, education materials, and funds.
                </p>
            </div>
        </div>

        <div class="card">
            <div class="card-img-wrapper">
                <img src="~/images/img10.png" alt="Nursing Home" class="card-img">
            </div>
            <div class="card-body">
                <h3>The Elderly</h3>
                <p>
                    With 7% of Malaysians aged over 65, many seniors in care homes lack family support.
                    They rely on public donations for medical supplies, food, and emotional care.
                </p>
            </div>
        </div>

        <div class="card">
            <div class="card-img-wrapper">
                <img src="~/images/img9.png" alt="Refugee support" class="card-img">
            </div>
            <div class="card-body">
                <h3>Refugees</h3>
                <p>
                    Refugees from Myanmar and Pakistan often lack access to formal employment.
                    Community donations are vital for their independence and survival.
                </p>
            </div>
        </div>
    </section>

    <section class="conclusion-box">
        <div class="conclusion-content">
            <h2>Who are we: Givehub</h2>
            <p>
                Givehub is a transparent, user-friendly donation platform.
                We vet every donee to ensure your money and items donation reach those who truly need it.
            </p>
            <a class="custom-btn" asp-controller="Home" asp-action="Donation">Donate Now</a>
        </div>
    </section>
</div>