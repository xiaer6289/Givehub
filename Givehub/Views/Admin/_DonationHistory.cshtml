@model IEnumerable<Donation>
<link rel="stylesheet" href="~/css/app.css" />
<p>@(Model?.Count() ?? 0) record(s)</p>

<link rel="stylesheet" href="app.css">
<table class="donation-history-table">
	<thead>
	<tr>
		<th>Id</th>
		<th>Method</th>
		<th>Amount</th>
		<th>Date</th>
		<th>Items</th>
		<th>Donee</th>
	</tr>
	<thead>

	<tbody>
	@if (Model != null)
	{
		@foreach(var s in Model)
		{
		
			<tr>
				<td>@s.Id</td>
				<td>@s.Method</td>
				<td>@s.Amount</td>
				<td>@s.Date</td>
				<td>@s.Items</td>
				<td>@s.DoneeId</td>
				<th>
					<button data-get="  ">Detail</button>
				</th>
			</tr>
		}
	}
	</tbody>

</table>