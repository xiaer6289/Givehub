@model IEnumerable<ItemManagementVM>

@if (ViewBag.EmptySearchMessage != null)
{
    <div class="alert-warning">
        @ViewBag.EmptySearchMessage
    </div>
}

<h1 class="item-management">Donation Items Management</h1>
<div class="page-actions">
    <a asp-controller="Admin"
       asp-action="ManageDonor"
       class="btn-return">
        ← Return
    </a>
</div>
<p>@(Model?.Count() ?? 0) record(s)</p>

<link rel="stylesheet" href="app.css">
<form asp-action="ItemManagement" method="get" class="search-bar">
    <input type="text"
           name="search"
           placeholder="Search by ID, donor, donee, item, or status"
           value="@ViewBag.Search"
           class="search-input" />

    <button type="submit" class="btn-search">Search</button>

    @if (!string.IsNullOrEmpty(ViewBag.Search))
    {
        <a asp-action="ItemManagement" class="btn-clear">Clear</a>
    }
</form>



<table class="donation-history-table">
	<thead>
	<tr>
		<th>Id</th>
        <th>Donor</th>
		<th>Donee</th>
        <th>Date</th>
		<th>Item</th>
		<th>Quantity</th>
        <th>Status</th>
        <th>Action</th>

	</tr>
	<thead>

	<tbody>
		@if (Model != null && Model.Any()) //the model exist and contain at least one record
        {
            foreach (var donation in Model)
            {

				bool firstRow = true;
                int rowCount = donation.Items.Count;

                foreach (var item in donation.Items)
                {
                    <tr class="donation-row donation-@donation.Id">
                        @if(firstRow){
                        <td rowspan="@rowCount">@donation.Id</td>
                        <td rowspan="@rowCount">@donation.DonorName</td>
                        <td rowspan="@rowCount">@donation.DoneeName</td>
                        <td rowspan="@rowCount">@donation.Date.ToString("yyyy-MM-dd HH:mm")</td>
                        }
                        <td>@item.ItemName</td>
                        <td>@item.Quantity</td>

                        @if(firstRow){
                        <td rowspan="@rowCount">@donation.Status</td> 

                        <td rowspan="@rowCount">
                            <form asp-action="UpdateStatus" method="post" class="status-form">
                                <input type="hidden" name="id" value="@donation.Id" />
                                <select name="status" class="action-select">
                                  <option value="Pending" selected="@(donation.Status == "Pending")">Pending</option>
                                    <option value="Completed" selected="@(donation.Status == "Completed")">Completed</option>
                                    <option value="Not Received" selected="@(donation.Status == "Not Received")">Not Received</option>
                                </select>
                                <button class="btn-update">Update</button>
                                </form>
                        </td>
                        }
                            </tr>

                            firstRow = false;   
                        }
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="no-record">
                            No record
                        </td>
                    </tr>
                }
            </tbody>
</table>

@if (ViewBag.TotalPages > 1)
{
    <div class="paging">
        <a asp-action="ItemManagement"
           asp-route-page="@(ViewBag.CurrentPage > 1 ? ViewBag.CurrentPage - 1 : 1)"
           asp-route-search="@ViewBag.Search">
            Previous
        </a>

        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            if (i == ViewBag.CurrentPage)
            {
                <span class="current-page">@i</span>
            }
            else
            {
                <a asp-action="ItemManagement"
                   asp-route-page="@i"
                   asp-route-search="@ViewBag.Search">@i</a>
            }
        }

        <a asp-action="ItemManagement"
           asp-route-page="@(ViewBag.CurrentPage<ViewBag.TotalPages? ViewBag.CurrentPage + 1 : ViewBag.TotalPages)"
           asp-route-search="@ViewBag.Search">
            Next
        </a>
    </div>

}

<script >
        document.addEventListener('DOMContentLoaded', function () {
        document.body.addEventListener('submit', function(e) {
            const form = e.target;
            if (!form.classList.contains('status-form')) return;

            e.preventDefault();

            // Get the selected status
            const selectedStatus = form.querySelector('select[name="status"]').value;

            if (selectedStatus === "Pending") {
            alert("You cannot update the status to Pending.");
            return; 
        }

            // Only apply fade-out if status is NOT Pending
            if (selectedStatus !== "Pending") {

                 const confirmUpdate = confirm(`Are you sure you want to update the status to "${selectedStatus}"?`);
                 if (!confirmUpdate) return;

                const donationId = form.querySelector('input[name="id"]').value;
                document.querySelectorAll(`.donation-${donationId}`)
                    .forEach(row => row.classList.add('fade-out'));

                // Submit after animation
                setTimeout(() => form.submit(), 600);
            } 
        });
    });
</script>
