@{
    ViewBag.Title = "Payment";
    Layout = "_EmptyLayout";
}

<form class="payment-container" asp-controller="Payment" asp-action="CreateCheckoutSession">
    <input type="hidden" name="donorId" value="@ViewBag.DonorId" />
    <input type="hidden" name="doneeId" value="@ViewBag.DoneeId" />
    <div class="payment-header">
        Make a Donation
    </div>
    <div class="slogan-text">
        <p x-text="slogan" class="fade-text"></p>
    </div>
    <div class="payment-input">
        <span class="currency-symbol">RM</span>
        <input type="number" placeholder="0" class="amount-input" autofocus min="10" name="amount" value="" id="amountInput"required />
    </div>
    <div class="payment-btn-grp">
        <a asp-controller="Home" asp-action="Index" class="cancel-payment-btn">Cancel</a>
        <button class="cta-btn" type="submit" id="checkoutBtn">
            <span>Proceed to Checkout</span>
        </button>
    </div>

    <div class="trust-footer">
        <div class="trust-item">
            <div class="trust-item">
                <span class="material-symbols-sharp trust-icon-secure">lock</span>
                <span class="font-semibold">Securely Processed, 100% to Donee</span>
            </div>
            <div class="trust-item">
                <span class="material-symbols-sharp trust-icon-info">done</span>
                <span class="font-smibold">Funds are Tracked and Guranteed</span>
            </div>
        </div>
    </div>
</form>
