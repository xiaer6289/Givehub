@{
    ViewBag.Title = "Item Donation Report";
    Layout = "_EmptyLayout";
}

<div class="money-report" id="ItemReportPDF">
    <div class="report-header">
        <img src="~/images/logo.png" alt="Givehub Logo" class="report-logo">
        <div class="report-top">
            <h1>Givehub</h1>
            <h5>Jalan null, Taman Null, 11000, Selayang, Selangor</h5>
            <h5>Tel: 03-00000000</h5>
        </div>
    </div>
    <h1 class="title">Item Donation Report</h1>
    <div class="output-wrapper">
        <h4>Name: </h4>
        <span>John Doe</span>
    </div>
    <div class="output-wrapper">
        <h4>Email: </h4>
        <span>johndoe@example.com</span>
    </div>
    <table class="item-table-report">
        <thead>
            <tr>
                <th>No.</th>
                <th>Organization Name</th>
                <th>Donated Item</th>
                <th>Item Quantity</th>
                <th>Donated Date</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <!--use for loop to print out the each payment-->
                <td>1</td>
                <td>Nursing Home</td>
                <td>Medicine</td>
                <td>20</td>
                <td>2025-11-28</td>
            </tr>
            <tr>
                <td>2</td>
                <td>Nursing Home</td>
                <td>Medicine</td>
                <td>20</td>
                <td>2025-11-28</td>
            </tr>
            <tr>
                <td>3</td>
                <td>Nursing Home</td>
                <td>Medicine</td>
                <td>20</td>
                <td>2025-11-28</td>
            </tr>
        </tbody>
    </table>
    <div class="report-footer">
        <p class="footer-title">Thank you for your contribution</p>
        <p>Your kindness helps us continue to support communities in need.</p>

        <div class="footer-signature">
            <div>
                <hr>
                <span>Authorized Signature</span>
            </div>
        </div>
        <p class="footer-note">This is a system-generated report. No signature is required</p>
    </div>
</div>

<div class="btn-grp">
    <button class="pdf-btn" type="button" onclick="generatePDF('ItemReportPDF', 'Item Donation Report')" id="savePdf">
        Print PDF
        <span class="material-symbols-sharp">print</span>
    </button>
    <a asp-controller="Home" asp-action="Index" class="return-btn">
        Return
        <span class="material-symbols-sharp">keyboard_return</span>
    </a>
</div>