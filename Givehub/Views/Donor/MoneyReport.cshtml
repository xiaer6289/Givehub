@{
    ViewBag.Title = "Donor Report";
    Layout = "_EmptyLayout";
}

<div class="money-report" id="PDF">
    <div class="report-header">
        <img src="~/images/logo.png" alt="Givehub Logo" class="report-logo">
        <div class="report-top">
            <h1>Givehub</h1>
            <h5>Jalan null, Taman Null, 11000, Selayang, Selangor</h5>
            <h5>Tel: 03-00000000</h5>
        </div>
    </div>
    <h1 class="title">Money Donation Report</h1>
    <table class="table-report">
        <thead>
            <tr>
                <th>No.</th>
                <th>Organization Name</th>
                <th>Donated Date</th>
                <th>Amount (RM)</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <!--use for loop to print out the each payment-->
                <td>1</td>
                <td>Nursing Home</td>
                <td>2025-11-28</td>
                <td>3000</td>
            </tr>
            <tr>
                <td>2</td>
                <td>Nursing Home</td>
                <td>2025-11-28</td>
                <td>5000</td>
            </tr>
            <tr>
                <td>3</td>
                <td>Nursing Home</td>
                <td>2025-11-28</td>
                <td>4000</td>
            </tr>
            <tr>
                <td></td>
                <td></td>
                <td style="text-align: right;">Total Amount:</td>
                <td>12000</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="btn-grp">
    <button class="pdf-btn" type="button" onclick="generatePDF()" id="savePdf">
        Print PDF
        <span class="material-symbols-sharp">print</span>
    </button>
    <a asp-controller="Home" asp-action="Index" class="return-btn">
        Return
        <span class="material-symbols-sharp">keyboard_return</span>
    </a>
</div>