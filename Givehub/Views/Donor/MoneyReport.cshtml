@model Givehub.Models.ReportVM
@using System.Linq


@{
    ViewBag.Title = "Donor Report";
    Layout = "_EmptyLayout";
}

<div class="money-report" id="MoneyReportPDF">
    <div class="report-header">
        <img src="~/images/logo.png" alt="Givehub Logo" class="report-logo">
        <div class="report-top">
            <h1>Givehub</h1>
            <h5>Jalan null, Taman Null, 11000, Selayang, Selangor</h5>
            <h5>Tel: 03-00000000</h5>
        </div>
    </div>
    <h1 class="title">Money Donation Report</h1>
    <div class="output-wrapper">
        <h4>Name: </h4>
        <span>@Model.DonorName</span>
    </div>
    <div class="output-wrapper">
        <h4>Email: </h4>
        <span>@Model.DonorEmail</span>
    </div>
    <table class="money-table-report">
        <thead>
            <tr>
                <th>No.</th>
                <th>Organization Name</th>
                <th>Donated Date</th>
                <th>Amount (RM)</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Donations.Count; i++)
            {
                var donation = Model.Donations[i];
                <tr style="border: none;">
                    <td style="border: none;">@(i + 1)</td>
                    <td style="border: none;">@donation.Donees?.Name</td>
                    <td style="border: none;">@donation.Date.ToString("yyyy-MM-dd")</td>
                    <td style="border: none;">@donation.Amount?.ToString("F2")</td>
                </tr>
            }
            @{
                decimal totalAmount = Model.Donations.Sum(d => d.Amount ?? 0);
            }

            <tr>
                <td colspan="3" style="text-align: right; border: none;">Total Amount:</td>
                <td>@totalAmount.ToString("F2")</td>
            </tr>
        </tbody>
    </table>
    <div class="report-footer">
        <p class="footer-title">Thank you for your contribution</p>
        <p>Your kindness helps us continue to support communities in need.</p>

        <div class="footer-signature">
            <div>
                <hr>
                <span>Authorized Signature</span>
            </div>
        </div>
        <p class="footer-note">This is a system-generated report. No signature is required</p>
    </div>
</div>

<div class="btn-grp">
    <button class="pdf-btn" type="button" onclick="generatePDF('MoneyReportPDF', 'Money Donation Report')" id="savePdf">
        Print PDF
        <span class="material-symbols-sharp">print</span>
    </button>
    <a asp-controller="Home" asp-action="Index" class="return-btn">
        Return
        <span class="material-symbols-sharp">keyboard_return</span>
    </a>
</div>