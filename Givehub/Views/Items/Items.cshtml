@model Givehub.Models.ItemDonationViewModel;

<body class="item-page">
    <div class="item-container">
        <h1>Make a Difference Today</h1>
        <p>Your donations help families in need. Every contribution counts.</p>
        <div class="slogan">
            <div class="slogan-item">
                <div class="slogan-icon">⚡</div>
                <div class="slogan-label">Fast & Easy</div>
            </div>
            <div class="slogan-item">
                <div class="slogan-icon">🎯</div>
                <div class="slogan-label">Direct Impact</div>
            </div>
            <div class="slogan-item">
                <div class="slogan-icon">🔒</div>
                <div class="slogan-label">Secure & Trusted</div>
            </div>
        </div>

        <div class="page-actions">
            <a asp-controller="Home"
               asp-action="Donation"
               class="btn-return">
                ← Return
            </a>
        </div>

        <form asp-controller="Items" class="donation-entry-form" id="donation-wrapper" method="post" asp-action="Items">
            <input type="hidden" asp-for="DoneeId" />
            <div class="donation-header">Donate Items :</div>
            @for (int i = 0; i < Model.Donation.Items.Count; i++)
            {
            <div class="donation-entry">
                <div class="donation-form">
                    <label for="ItemName">Choose an item: </label>
                    <select name="Donation.Items[@i].ItemName" class="item-name-input">
                        @foreach (var item in Model.AvailableItems)
                        {
                                <option value="@item" selected="@(item == Model.Donation.Items[i].ItemName)">@item</option>
                        }
                    </select>
                    <label for="Quantity" class="quantity" value="1">Quantity: </label>
                        <input name="Donation.Items[@i].Quantity" class="item-qty-input" type="number" min="1" max="50" value="@Model.Donation.Items[i].Quantity" required />
                </div>
                <div class="remove-donation-button">
                    <span class="material-symbols-sharp">delete</span>
                </div>
                
            </div>
            }
            <div class="delivery-date">
                <label type="date">Select delivery date:</label>
                <input type="datetime-local" asp-for="Donation.DeliveryDate" min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" class="form-control" required value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
            </div>
            <div class="button-section">
                <button class="add-more-button" id="add-more-button">
                    + Add New Donation
                </button>
                <button type="submit" class="donate-button">Donate</button>
            </div>
        </form>
    </div>
</body>
