@{
    ViewData["Title"] = "Donation Successful";
}

<div class="success-container" >
    <div class="success-icon">🎉</div>
    <div class="success-title">Thank You!</div>
    <div class="success-message">Your donation has been successfully submitted.</div>
    <div class="success-submessage">We appreciate your generosity and support.</div>

    <a asp-controller="Home" asp-action="Index" class="success-btn-home">Return to Home</a>
    <a asp-controller="Donor" asp-action="ItemReport" class="success-btn-report">View My Donations</a>
</div>
