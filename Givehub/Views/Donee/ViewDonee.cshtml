@model Givehub.Models.ViewModels.DoneeVM
@{
    ViewBag.Title = "View Donee";
    Layout = "_EmptyLayout";
}

<div class="create-donee-container">

    <h2>Donee Details</h2>

    <div class="input-wrapper">
        <label>Name:</label>
        <p>@Model.Name</p>
    </div>

    <div class="input-wrapper">
        <label>Category:</label>
        <p>@Model.Category</p>
    </div>

    <div class="input-wrapper">
        <label>Address:</label>
        <p>@Model.Address</p>
    </div>

    <div class="input-wrapper">
        <label>Requirements:</label>
        <p>
            @(Model.Requirements != null ? string.Join(",", Model.Requirements) : "-")
            </p>
    </div>

    <div class="input-wrapper">
        <label>Description:</label>
        <p>@Model.Description</p>
    </div>

    <div class="input-wrapper">
        <label>Image:</label>
        <div class="donee-img-wrapper">
            <img src="@Url.Content(Model.Image)" class="donee-img" alt="Donee Image" />
        </div>
    </div>

    <div class="btn-grp">
        <a href="@Url.Action("EditDonee", "Donee", new { id = Model.Id })" class="edit-btn">Edit</a>
        <a href="@Url.Action("DoneeHomePage", "Donee")" class="cancel-btn">Back</a>
    </div>
</div>
