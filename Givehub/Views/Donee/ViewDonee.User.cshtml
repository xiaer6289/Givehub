@model Givehub.Models.ViewModels.DoneeVM
@{
    ViewBag.Title = "Donee Details";
    Layout = "_Layout";
}

<div class="create-donee-container">

    <h2>Donee Details</h2>

    <div class="input-wrapper">
        <label>Date Created:</label>
        <p class="donee-input">@Model.Date.ToString("dd MMM yyyy")</p>
    </div>

    <div class="input-wrapper">
        <label>Name:</label>
        <p class="donee-input">@Model.Name</p>
    </div>

    <div class="input-wrapper">
        <label>Category:</label>
        <p class="donee-input">@Model.Category</p>
    </div>

    <div class="input-wrapper">
        <label>Address:</label>
        <p class="donee-input">@Model.Address</p>
    </div>

    <div class="input-wrapper">
        <label>Requirements:</label>
        <p class="donee-input">
            @(Model.Requirements != null && Model.Requirements.Any()
                        ? string.Join(", ", Model.Requirements)
                        : "-")
        </p>
    </div>

    <div class="input-wrapper">
        <label>Description:</label>
        <p class="donee-input">@Model.Description</p>
    </div>

    <div class="input-wrapper">
        <label>Image:</label>
        <div class="donee-img-wrapper preview">
            @if (!string.IsNullOrEmpty(Model.Image))
            {
                <img src="@Url.Content(Model.Image)"
                     class="donee-img"
                     style="width:200px;height:200px;border-radius:5px;" />
            }
            else
            {
                <img src="~/images/no-image.png"
                     class="donee-img"
                     style="width:200px;height:200px;border-radius:5px;" />
            }
        </div>
    </div>

    <div class="btn-grp">

        <a asp-controller="Home"
           asp-action="Donation"
           class="cancel-btn">
            Return
        </a>

        <button class="submit-btn" onclick="location.href='@Url.Action("Payment", "Payment", 
        new { doneeId = Model.Id })'">
            Donate Money
        </button>

        <button class="submit-btn secondary" onclick="location.href='@Url.Action("Items", "Items", 
        new { doneeId = Model.Id })'">
            Donate Items
        </button>

    </div>
</div>
